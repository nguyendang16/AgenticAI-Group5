# LLM runtime (OpenAI-compatible; BASE_URL is the only required field in most local deployments)
BASE_URL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
API_KEY=
AGENT_MODEL=gpt-5-mini
# Reasoning effort for GPT-5 models: low, medium, high, xhigh
AGENT_REASONING_EFFORT=low
# Set true to use OpenAI Responses API instead of Chat Completions API.
OPENAI_USE_RESPONSES_API=false
AGENT_RESUME_ATTEMPTS=2
# Recommended for local OpenAI-compatible gateways to avoid OpenAI tracing 401 noise
OPENAI_AGENTS_DISABLE_TRACING=1

# MinerU v4
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_UPLOAD_ENDPOINT=/file-urls/batch
MINERU_POLL_ENDPOINT_TEMPLATES=/extract-results/batch/{batch_id},/extract-results/{batch_id},/extract/task/{batch_id}
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_POLL_TIMEOUT_SECONDS=900
MINERU_ALLOW_LOCAL_FALLBACK=false

# Paper search provider.
# Recommended: DeepXiv direct API. Register for a token, set DEEPXIV_API_TOKEN,
# and run DeepReviewer without starting a PASA service.
PAPER_SEARCH_ENABLED=true
PAPER_SEARCH_PROVIDER=deepxiv

DEEPXIV_API_BASE_URL=https://data.rag.ac.cn
DEEPXIV_API_TOKEN=
DEEPXIV_REQUEST_TIMEOUT_SECONDS=60
DEEPXIV_RETRIEVE_TOP_K=8
DEEPXIV_DEFAULT_SOURCE=arxiv

# Alternative: local PASA service. Set PAPER_SEARCH_PROVIDER=pasa, start
# pasa/start_pasa_server.sh, then point these settings at the Flask service.
PAPER_SEARCH_BASE_URL=http://127.0.0.1:8001
PAPER_SEARCH_API_KEY=
PAPER_SEARCH_ENDPOINT=/pasa/search
PAPER_SEARCH_TIMEOUT_SECONDS=120
PAPER_SEARCH_HEALTH_ENDPOINT=/health
PAPER_SEARCH_HEALTH_TIMEOUT_SECONDS=5

#neo4j setup
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# Optional external paper read API. If unset, read_paper falls back to arXiv
# metadata/abstract-level reading.
PAPER_READ_BASE_URL=
PAPER_READ_API_KEY=
PAPER_READ_ENDPOINT=/read
PAPER_READ_TIMEOUT_SECONDS=180

# Fast review (improved quality mode): more turns, more context, more annotations.
# Review criteria knowledge graph (Neo4j + optional JSON fallback)
REVIEW_CRITERIA_ENABLED=true
REVIEW_VENUE=
REVIEW_JOURNAL=
REVIEW_DOMAIN=
REVIEW_ARTICLE_TYPE=
REVIEW_INFER_VENUE_FROM_PAPER=true
REVIEW_CRITERIA_JSON_DIR=outputs/extracted_json

REVIEW_FAST_MODE=false
REVIEW_FAST_MAX_TURNS=40
REVIEW_FAST_MAX_MARKDOWN_CHARS=100000
REVIEW_FAST_MIN_ANNOTATIONS=8

# Gates
ENABLE_FINAL_GATES=false
MIN_PAPER_SEARCH_CALLS_FOR_PDF_ANNOTATE=3
MIN_PAPER_SEARCH_CALLS_FOR_FINAL=3
MIN_DISTINCT_PAPER_QUERIES_FOR_FINAL=3
MIN_ANNOTATIONS_FOR_FINAL=10
MIN_ENGLISH_WORDS_FOR_FINAL=0
MIN_CHINESE_CHARS_FOR_FINAL=0
FORCE_ENGLISH_OUTPUT=true
UI_LANGUAGE=en

# PDF export branding
PDF_BRAND_NAME=DILab
PDF_PRODUCER_NAME=DILab
PDF_LOGO_PATH=assets/branding/logo.png

# Submit behavior
SUBMIT_DEFAULT_WAIT_SECONDS=8
SUBMIT_POLL_INTERVAL_SECONDS=1
MAX_PDF_BYTES=52428800

# Eval (Gemma via Google AI Studio — judge + RAGAS)
BENCHMARK_EVAL_PROVIDER=google
BENCHMARK_EVAL_MODEL=gemma-4-31b-it
GOOGLE_API_KEY=
BENCHMARK_JUDGE_MODE=composite
BENCHMARK_EVAL_PAUSE_SECONDS=5
BENCHMARK_RAGAS_MAX_CLAIMS=10
BENCHMARK_RAGAS_MAX_CONTEXT_CHARS=2000
